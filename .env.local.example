# === Supabase ===
# Project Settings → API in your Supabase dashboard
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service role key — used ONLY server-side in app/api/rsvp/route.ts to
# upload photos and insert RSVPs reliably (bypasses RLS safely, since the
# route validates all input itself). NEVER prefix this with NEXT_PUBLIC_
# and never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# === Email notifications (via Resend) ===
# 1. Sign up at https://resend.com and create an API key at
#    https://resend.com/api-keys — paste it below.
# 2. Until you verify a domain in Resend, emails can ONLY be sent to the
#    email address that owns the Resend account (fine for testing).
#    Verify a domain (Resend → Domains) to send to any guest's inbox.
RESEND_API_KEY=re_your_api_key

# Must stay "onboarding@resend.dev" until a domain is verified in Resend.
# After verifying a domain, change this to e.g. wedding@yourdomain.com
RESEND_FROM_EMAIL=onboarding@resend.dev

# The couple's inbox that should receive RSVP notification emails
COUPLE_NOTIFICATION_EMAIL=couple@example.com
